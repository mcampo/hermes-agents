# Runtime values belong only in the live profile's .env on the RPi:
# ~/.hermes/profiles/mojo/.env
# Do not commit or paste real values into this file.
#
# Obtain provider keys from each provider's account dashboard. Telegram values
# come from BotFather and the allowlist should contain the permitted Telegram
# user IDs. Google Workspace OAuth is managed by the bundled skill and its
# credential files; do not copy those files into this repository.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
FIRECRAWL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=

# Private values used by the custom gastos-vencimientos skill. Retrieve these
# from the live profile or its Drive/Sheets setup; never put the values here.
GASTOS_VENCIMIENTOS_EMAIL=
GASTOS_VENCIMIENTOS_SHEET_ID=
GASTOS_VENCIMIENTOS_DRIVE_ROOT_ID=
GASTOS_VENCIMIENTOS_EXPENSAS_OWNER=
MERCADO_PAGO_PDF_PASSWORD=

# Private location used by the daily weather script.
MOJO_WEATHER_LAT=
MOJO_WEATHER_LON=
MOJO_WEATHER_CITY=
